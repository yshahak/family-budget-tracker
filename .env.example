# ── Telegram ─────────────────────────────────────────────────────────────────
# Get token from @BotFather. Get chat_id by adding @userinfobot to your group.
TELEGRAM_BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# ── Owner display names (shown in Telegram messages) ─────────────────────────
OWNER1_DISPLAY=Alice
OWNER2_DISPLAY=Bob

# ── Isracard (Owner 1) ────────────────────────────────────────────────────────
ISRACARD_ID=123456789          # Israeli ID number
ISRACARD_DIGITS=123456         # Last 6 digits of the Isracard card
ISRACARD_PASS=yourpassword

# ── Max credit card (Owner 1) ─────────────────────────────────────────────────
MAX_ID=your_max_username
MAX_PASS=yourpassword

# ── Isracard (Owner 2) ────────────────────────────────────────────────────────
# Leave blank to disable this scraper profile
OWNER2_ISRACARD_ID=987654321
OWNER2_ISRACARD_DIGITS=654321
OWNER2_ISRACARD_PASS=yourpassword

# ── Bank Hapoalim ─────────────────────────────────────────────────────────────
# Requires OTP on first login — see LLM_STARTER.md for the OTP flow
HAPOALIM_USER=your_hapoalim_username
HAPOALIM_PASS=yourpassword

# ── Google Gemini (auto-categorization) ──────────────────────────────────────
# Free tier works fine. Get key at https://aistudio.google.com/
# Leave blank to skip Gemini and rely on rules + manual Telegram categorization
GEMINI_API_KEY=AIzaSy_your_key_here

# ── Cloud Run (set automatically by the deployment, do not set locally) ───────
# WEBHOOK_URL=https://your-service.run.app
# PORT=8080
